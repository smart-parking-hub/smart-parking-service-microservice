# ==============================================================================
# SMART PARKING HUB - ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# ==============================================================================
# Hướng dẫn sử dụng:
# 1. Sao chép tệp này thành .env trong thư mục smart-parking-microservice:
#    cp .env.example .env (hoặc copy .env.example .env trên Windows CMD/Powershell)
# 2. Cập nhật các giá trị cấu hình tương ứng với môi trường phát triển của bạn.
# 3. LƯU Ý: Không bao giờ commit tệp .env chứa thông tin bí mật lên Git repository!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. API GATEWAY & EDGE SECURITY (api-gateway: 8088)
# ------------------------------------------------------------------------------
# Cổng chạy của Spring Cloud API Gateway (Routing trung tâm cho toàn bộ hệ thống)
PORT=8088

# Khóa bí mật API Key bắt buộc truyền qua header X-App-Key tại API Gateway
# Giúp bảo vệ hệ thống khỏi các request lạ chưa được ủy quyền từ bên ngoài
APP_SECURITY_API_KEY=SP_APP_KEY_2026_xM99qP2!
# Bật (true) hoặc tắt (false) cơ chế xác thực X-App-Key tại API Gateway
APP_SECURITY_API_KEY_ENABLED=true

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (MySQL 8.4)
# ------------------------------------------------------------------------------
# Thông số kết nối MySQL Database (Database-per-service pattern)
# - Chạy local: cổng 3307 (đã expose từ Docker infra compose)
# - Chạy qua Docker container network: mysql:3306
DB_HOST=localhost
DB_PORT=3307
DB_USERNAME=root
DB_PASSWORD=root

# ------------------------------------------------------------------------------
# 3. SECURITY, JWT & INTER-SERVICE TRUST
# ------------------------------------------------------------------------------
# Secret key mã hóa JWT Token (Bắt buộc tối thiểu 256 bits / 32 ký tự bảo mật)
JWT_SECRET=smartparkingsecretkeymustbeverylongandsecure2026version
# Thời gian sống của JWT Access Token (86400000 ms = 24 giờ)
JWT_EXPIRATION_MS=86400000

# Token xác thực nội bộ P0 giữa các microservice (Inter-service Feign Call: X-Internal-Secret)
# Bắt buộc khớp nhau giữa booking-service, parking-lot-service, payment-service, identity-service và notification-service
APP_INTERNAL_SERVICE_TOKEN=internal-secret-token-smart-parking-2026

# ------------------------------------------------------------------------------
# 4. GOOGLE AI / GEMINI COPILOT & CONTENT GENERATOR (ai-service: 8086)
# ------------------------------------------------------------------------------
# API Key của Google AI Studio (Lấy miễn phí tại: https://aistudio.google.com/app/apikey)
# CƠ CHẾ DUAL-MODE / FALLBACK:
# - Nếu để trống hoặc 'demo-key': Hệ thống tự động kích hoạt Smart Fallback Engine
#   (vẫn sinh nội dung, tra cứu chính sách và tìm bãi đỗ xe qua Feign Tool Calling mượt mà, không lỗi 500).
# - Nếu điền API Key hợp lệ: Hệ thống gọi Google Gemini Cloud API thật để sinh nội dung & chat AI nâng cao.
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# ------------------------------------------------------------------------------
# 5. PAYMENT GATEWAY (PayOS Vietnam Integration - payment-service: 8084)
# ------------------------------------------------------------------------------
# Thông tin tích hợp cổng thanh toán VietQR / PayOS (Đăng ký tại: https://payos.vn)
PAYOS_CLIENT_ID=your_payos_client_id_here
PAYOS_API_KEY=your_payos_api_key_here
PAYOS_CHECKSUM_KEY=your_payos_checksum_key_here

# URL chuyển hướng sau khi hoàn tất hoặc hủy thanh toán trên cổng PayOS
PAYOS_RETURN_URL=http://localhost:3000/payment/return
PAYOS_CANCEL_URL=http://localhost:3000/payment/cancel

# Giả lập thanh toán sandbox cục bộ:
# - true: Bật chế độ demo payment, cho phép xác nhận thanh toán trực tiếp không cần gọi PayOS thật
# - false: Yêu cầu kết nối thanh toán VietQR / PayOS thật
APP_DEMO_PAYMENT_ENABLED=false

# Tự động đồng bộ và khôi phục trạng thái các giao dịch PayOS đang chờ xử lý (Recovery Engine)
PAYOS_RECOVERY_ENABLED=true

# Thư mục lưu trữ tệp đính kèm chứng từ khiếu nại tranh chấp (Dispute Evidence)
DISPUTE_EVIDENCE_DIR=uploads/dispute-evidence

# ------------------------------------------------------------------------------
# 6. BOOKING HOLD POLICY & ANTI-ABUSE (booking-service: 8083)
# ------------------------------------------------------------------------------
# Chính sách quản lý giữ chỗ chưa thanh toán và ngăn ngừa spam đơn đặt chỗ
BOOKING_HOLD_POLICY_ENABLED=true
# Số lượng đơn đặt giữ chỗ PENDING tối đa cho phép trên mỗi tài khoản
BOOKING_HOLD_MAX_PENDING=3
# Ngưỡng số đơn bỏ thanh toán/quá hạn trong khung giờ dẫn tới cảnh báo & áp dụng cooldown
BOOKING_HOLD_ABANDONMENT_THRESHOLD=2
# Khung thời gian theo dõi lịch sử vi phạm giữ chỗ (tính bằng phút)
BOOKING_HOLD_WINDOW_MINUTES=60
# Thời gian áp dụng phạt tạm dừng tạo yêu cầu giữ chỗ mới (cooldown, tính bằng phút)
BOOKING_HOLD_COOLDOWN_MINUTES=30
# Giới hạn số lượt tạo đơn giữ chỗ tối đa trong cửa sổ rate limit
BOOKING_HOLD_RATE_LIMIT=10
# Cửa sổ thời gian tính rate limit (tính bằng giây)
BOOKING_HOLD_RATE_WINDOW_SECONDS=60

# ------------------------------------------------------------------------------
# 7. DISTRIBUTED MESSAGE BROKER (Apache Kafka KRaft: 9092 / 29092)
# ------------------------------------------------------------------------------
# Địa chỉ Kafka bootstrap server:
# - Chạy dịch vụ trực tiếp trên máy host (Local IDE): localhost:9092
# - Chạy qua Docker Compose Network: kafka:29092
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ------------------------------------------------------------------------------
# 8. IN-MEMORY CACHE & DISTRIBUTED LOCK (Redis 7.2)
# ------------------------------------------------------------------------------
# Thông tin kết nối Redis Server (Caching, Queue, Idempotency)
REDIS_HOST=localhost
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# 9. EMAIL NOTIFICATION SERVICE (SMTP - notification-service: 8085)
# ------------------------------------------------------------------------------
# Cấu hình SMTP gửi mail xác thực OTP, biên nhận đặt chỗ và hóa đơn thanh toán
# Dùng Gmail: host=smtp.gmail.com, port=587, auth=true, starttls=true
# Dùng Mailpit (Docker Dev): host=localhost, port=1025, auth=false, starttls=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_google_app_password_here
MAIL_FROM=your_email@gmail.com
MAIL_SMTP_AUTH=true
MAIL_STARTTLS_ENABLE=true

# ------------------------------------------------------------------------------
# 10. MICROSERVICE URLS (Inter-service Feign Communication & Gateway Routing)
# ------------------------------------------------------------------------------
# Địa chỉ phân giải của từng microservice (Dành cho API Gateway và Feign Client)
# Local Host Mode (Chạy từng service qua IDE hoặc lệnh Java):
IDENTITY_SERVICE_URL=http://localhost:8081
PARKING_LOT_SERVICE_URL=http://localhost:8082
BOOKING_SERVICE_URL=http://localhost:8083
PAYMENT_SERVICE_URL=http://localhost:8084
NOTIFICATION_SERVICE_URL=http://localhost:8085
AI_SERVICE_URL=http://localhost:8086

# Multi-VPS cluster only: provision reachable private/TLS endpoints on the owning
# host before rendering its Compose file. These have no production defaults.
# VPS 3: BOOKING_IDENTITY_SERVICE_URL and BOOKING_PAYMENT_SERVICE_URL
# VPS 2: PAYMENT_BOOKING_SERVICE_URL
# BOOKING_IDENTITY_SERVICE_URL=
# BOOKING_PAYMENT_SERVICE_URL=
# PAYMENT_BOOKING_SERVICE_URL=

# Docker Container Mode (Nếu triển khai trọn bộ qua Docker Compose):
# IDENTITY_SERVICE_URL=http://identity-service:8081
# PARKING_LOT_SERVICE_URL=http://parking-lot-service:8082
# BOOKING_SERVICE_URL=http://booking-service:8083
# PAYMENT_SERVICE_URL=http://payment-service:8084
# NOTIFICATION_SERVICE_URL=http://notification-service:8085
# AI_SERVICE_URL=http://ai-service:8086

# ------------------------------------------------------------------------------
# 11. PARKING LAYOUT & PHYSICAL SLOT MANAGEMENT (parking-lot-service: 8082)
# ------------------------------------------------------------------------------
# Quản lý sơ đồ bãi đỗ 2D/3D và đặt chính xác ô vật lý (Physical slot booking)
APP_PARKING_LAYOUT_ENABLED=false
APP_PARKING_LAYOUT_PHYSICAL_BOOKING_ENABLED=false

# ------------------------------------------------------------------------------
# 12. OBSERVABILITY, CODE QUALITY & MONITORING (Prometheus, Grafana, SonarQube)
# ------------------------------------------------------------------------------
# Mật khẩu quản trị Grafana Dashboard (Cổng 3001)
GF_SECURITY_ADMIN_PASSWORD=admin
# Bỏ qua kiểm tra bootstrap Elasticsearch của SonarQube trên môi trường phát triển
SONAR_ES_BOOTSTRAP_CHECKS_DISABLE=true
# SonarQube User Analysis Token (Dành cho `./gradlew sonar`)
SONAR_TOKEN=squ_your_sonarqube_token_here

# ------------------------------------------------------------------------------
# 13. SERVICE DISCOVERY & CONFIG SERVER (Spring Cloud / Eureka - Tùy chọn)
# ------------------------------------------------------------------------------
EUREKA_CLIENT_ENABLED=false
EUREKA_SERVER_URL=http://localhost:8761/eureka/
CONFIG_PROFILE=native
GIT_CONFIG_URI=https://github.com/example/smartparking-config-repo

# ------------------------------------------------------------------------------
# 14. CLOUDINARY MEDIA STORAGE (parking-lot-service: 8082)
# ------------------------------------------------------------------------------
# Dịch vụ lưu trữ và nén ảnh bãi đỗ xe Cloudinary (Tùy chọn / Khuyên dùng)
# Đăng ký miễn phí tại: https://cloudinary.com
# Lấy thông tin tại: Dashboard -> Product Environment Settings -> API Keys
# LƯU Ý: Nếu để trống các biến dưới đây, hệ thống sẽ tự động lưu cục bộ (Local FileSystem)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=smartparking/lots

# Casso IDKit merchant tax lookup (Identity only; keep credentials in ignored .env)
CASSO_TAX_LOOKUP_ENABLED=false
CASSO_APP_ID=
CASSO_APP_SECRET=
CASSO_TAX_LOOKUP_TIMEOUT=5s
CASSO_TAX_LOOKUP_MINIMUM_INTERVAL=3s
