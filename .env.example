# ==============================================================================
# SMART PARKING HUB - ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# Sao chép tệp này thành .env trong thư mục smart-parking-service-microservice:
# cp .env.example .env (hoặc copy .env.example .env trên Windows)
# LƯU Ý: Không commit tệp .env chứa thông tin bí mật lên Git repository!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. API GATEWAY & SYSTEM PORTS
# ------------------------------------------------------------------------------
# Cổng chạy của Spring Cloud API Gateway (Routing trung tâm cho toàn bộ hệ thống)
PORT=8088

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (MySQL 8.4)
# ------------------------------------------------------------------------------
# Thông số kết nối MySQL Database (Database-per-service pattern)
# Chạy local dùng cổng 3307 (đã expose từ Docker infra), chạy qua Docker network dùng mysql:3306
DB_HOST=localhost
DB_PORT=3307
DB_USERNAME=root
DB_PASSWORD=root

# ------------------------------------------------------------------------------
# 3. SECURITY & JWT AUTHENTICATION
# ------------------------------------------------------------------------------
# Secret key mã hóa JWT Token (Bắt buộc tối thiểu 256 bits / 32 ký tự bảo mật)
JWT_SECRET=smartparkingsecretkeymustbeverylongandsecure2026version
# Thời gian sống của JWT token (86400000 ms = 24 giờ)
JWT_EXPIRATION_MS=86400000

# ------------------------------------------------------------------------------
# 4. GOOGLE AI / GEMINI COPILOT & CONTENT GENERATOR (ai-service: 8086)
# ------------------------------------------------------------------------------
# API Key của Google AI Studio (Lấy miễn phí tại: https://aistudio.google.com/app/apikey)
# CƠ CHẾ DUAL-MODE / FALLBACK:
# - Nếu để trống hoặc 'demo-key': Hệ thống tự động kích hoạt Smart Fallback Engine
#   (vẫn sinh nội dung, tra cứu chính sách và tìm bãi đỗ xe qua Feign Tool Calling mượt mà, không lỗi 500).
# - Nếu điền API Key hợp lệ: Hệ thống gọi Google Gemini Cloud API thật để sinh nội dung & chat AI nâng cao.
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# ------------------------------------------------------------------------------
# 5. PAYMENT GATEWAY (PayOS Vietnam Integration - payment-service: 8084)
# ------------------------------------------------------------------------------
# Thông tin tích hợp cổng thanh toán VietQR / PayOS (Đăng ký tại: https://payos.vn)
PAYOS_CLIENT_ID=your_payos_client_id_here
PAYOS_API_KEY=your_payos_api_key_here
PAYOS_CHECKSUM_KEY=your_payos_checksum_key_here

# ------------------------------------------------------------------------------
# 6. DISTRIBUTED MESSAGE BROKER (Apache Kafka KRaft: 9092 / 29092)
# ------------------------------------------------------------------------------
# Địa chỉ Kafka bootstrap server:
# - Chạy dịch vụ trực tiếp trên máy host (Local IDE): localhost:9092
# - Chạy qua Docker Compose Network: kafka:29092
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ------------------------------------------------------------------------------
# 7. IN-MEMORY CACHE & DISTRIBUTED LOCK (Redis 7.2)
# ------------------------------------------------------------------------------
# Thông tin kết nối Redis Server (Caching, Queue, Idempotency)
REDIS_HOST=localhost
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# 8. EMAIL NOTIFICATION SERVICE (SMTP - notification-service: 8085)
# ------------------------------------------------------------------------------
# Cấu hình SMTP gửi mail xác thực OTP, biên nhận đặt chỗ và hóa đơn thanh toán
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
# Địa chỉ Gmail người gửi và Mật khẩu ứng dụng 16 ký tự (Google App Password)
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_google_app_password_here

# ------------------------------------------------------------------------------
# 9. MICROSERVICE URLS (Inter-service Feign Communication & Gateway Routing)
# ------------------------------------------------------------------------------
# Địa chỉ phân giải của từng microservice (Dành cho API Gateway và Feign Client)
# Local Host Mode:
IDENTITY_SERVICE_URL=http://localhost:8081
PARKING_LOT_SERVICE_URL=http://localhost:8082
BOOKING_SERVICE_URL=http://localhost:8083
PAYMENT_SERVICE_URL=http://localhost:8084
NOTIFICATION_SERVICE_URL=http://localhost:8085
AI_SERVICE_URL=http://localhost:8086

# Docker Container Mode (Tùy chọn - nếu triển khai full qua Docker Compose):
# IDENTITY_SERVICE_URL=http://identity-service:8081
# PARKING_LOT_SERVICE_URL=http://parking-lot-service:8082
# BOOKING_SERVICE_URL=http://booking-service:8083
# PAYMENT_SERVICE_URL=http://payment-service:8084
# NOTIFICATION_SERVICE_URL=http://notification-service:8085
# AI_SERVICE_URL=http://ai-service:8086

# ------------------------------------------------------------------------------
# 10. OBSERVABILITY & MONITORING (Prometheus & Grafana)
# ------------------------------------------------------------------------------
# Mật khẩu quản trị Grafana Dashboard (Cổng 3001)
GF_SECURITY_ADMIN_PASSWORD=admin
# Bỏ qua kiểm tra bootstrap Elasticsearch của SonarQube trên môi trường phát triển
SONAR_ES_BOOTSTRAP_CHECKS_DISABLE=true

# ------------------------------------------------------------------------------
# 11. SERVICE DISCOVERY & CONFIG SERVER (Tùy chọn)
# ------------------------------------------------------------------------------
EUREKA_CLIENT_ENABLED=false
EUREKA_SERVER_URL=http://localhost:8761/eureka/
CONFIG_PROFILE=native
GIT_CONFIG_URI=https://github.com/example/smartparking-config-repo

# P0 trusted inter-service calls. Generate a unique random value for your environment.
# Must match in booking-service, parking-lot-service and payment-service.
APP_INTERNAL_SERVICE_TOKEN=
APP_DEMO_PAYMENT_ENABLED=false
PAYOS_RETURN_URL=http://localhost:3000/payment/return
PAYOS_CANCEL_URL=http://localhost:3000/payment/cancel

# Email OTP: identity -> notification (same nonempty service token in both services).
# Never expose OTP in API responses. Configure a real SMTP sender for external delivery.
MAIL_FROM=your_email@gmail.com
MAIL_SMTP_AUTH=true
MAIL_STARTTLS_ENABLE=true
