# ==============================================================================
# SMARTPARKINGHUB - TRELLO API CONFIGURATION TEMPLATE
# ==============================================================================
# Sao chép file này thành .trello.env tại thư mục gốc repository (hoặc trong scripts/trello/):
#   cp scripts/trello/.trello.env.example .trello.env
#
# 1. API Key & Token: Tạo tại https://trello.com/power-ups/admin
# 2. Board ID: Lấy từ URL board (https://trello.com/b/<BOARD_ID>/...) hoặc API
# ==============================================================================

# Khóa API cá nhân Trello
TRELLO_API_KEY=your_trello_api_key_here

# Token xác thực quyền truy cập Trello
TRELLO_API_TOKEN=your_trello_api_token_here

# ID của Trello Board đang hoạt động (Smart Parking Hub - Delivery)
TRELLO_ACTIVE_BOARD_ID=your_active_board_id_here
TRELLO_SPH_BOARD_ID=your_active_board_id_here
