# ==============================================================================
# SmartParkingHub - Microservices Git Ignore Configuration
# Comprehensive configuration to prevent committing binaries, caches, logs,
# Docker data volumes, and confidential secrets to maximize speed and save quota.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Gradle Build Outputs & Caches
# ------------------------------------------------------------------------------
.gradle/
build/
**/build/
out/
**/out/
bin/
**/bin/

# Compiled Java Classes & Archives
*.class
*.jar
*.war
*.ear
*.nar

# Keep Gradle Wrapper files intact
!gradle/wrapper/gradle-wrapper.jar
!gradle/wrapper/gradle-wrapper.properties
!gradlew
!gradlew.bat

# Do not ignore build configurations inside source trees
!**/src/main/**/build/
!**/src/test/**/build/
!**/src/main/**/bin/
!**/src/test/**/bin/

# ------------------------------------------------------------------------------
# 2. JVM Crash Logs, Profiler Dumps & Log Files
# ------------------------------------------------------------------------------
logs/
**/logs/
*.log
*.log.*
npm-debug.log*
yarn-debug.log*

# HotSpot crash reports & heap dumps
hs_err_pid*
replay_pid*
*.hprof
*.dump

# ------------------------------------------------------------------------------
# 3. Environment Variables & Secret Credentials
# ------------------------------------------------------------------------------
.env
.env.*
*.env
application-local.yml
application-local.yaml
application-local.properties
application-secret.yml
application-secret.yaml
application-secret.properties

# Whitelist safe configuration templates
!.env.example
!.env.template

# Security keys, certificates, keystores
*.keystore
*.jks
*.p12
*.pfx
*.pem
*.key
*.crt
*.cert

# ------------------------------------------------------------------------------
# 4. Docker, Databases & Message Brokers (Volumes & State)
# ------------------------------------------------------------------------------
# Local database mounts & volume states
**/data/
**/mysql-data/
**/postgres-data/
**/pgadmin-data/
**/redis-data/
**/kafka-data/
**/zookeeper-data/

# Redis snapshots & Kafka logs
*.rdb
*.aof
dump.rdb
/tmp/kraft-combined-logs/

# Database dumps and exports
*.sql.gz
*.backup

# ------------------------------------------------------------------------------
# 5. IDEs & Editors
# ------------------------------------------------------------------------------
# IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr
*.idea

# Eclipse / Spring Tool Suite (STS)
.apt_generated
.apt_generated_tests
.classpath
.factorypath
.project
.settings/
.springBeans
.sts4-cache

# Visual Studio Code
.vscode/
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json

# NetBeans
nbproject/private/
nbbuild/
dist/
nbdist/
.nb-gradle/

# General editor backups
*.swp
*.swo
*.swn
*~
*.bak

# ------------------------------------------------------------------------------
# 6. Operating System Files
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~
.directory

# ------------------------------------------------------------------------------
# 7. Temporary, Scratch & Large Archive Files
# ------------------------------------------------------------------------------
tmp/
temp/
**/tmp/
**/temp/
.agents/scratch/
/docs/trello-snapshot.json

# Archives (prevent accidental multi-megabyte / gigabyte pushes)
*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z
*.iso

# Local email OTP verification output
.email-otp-*.log

# Local uploaded runtime files
uploads/
**/uploads/

# Python cache
__pycache__/
*.pyc
scripts/trello
docs/pr-reviews
.taste-skill/

# Local deployment metadata and dated scratch reports; summaries live in runbooks.
.deploy-history/
/.local/
/docs/implementation/vps-release-audit-*.json
/docs/implementation/vps-release-audit-*.md
/docs/implementation/casso-env-validation-20261119.md
/docs/implementation/compose-maintenance-plan-20261119.md
/docs/implementation/dual-source-deploy-plan-20261119.md
/docs/implementation/menu-deploy-fix-plan-20261119.md
/docs/implementation/menu-progress-plan-20261119.md
