  "item": [
    {
      "name": "1. AI Copilot Chatbot (Driver Assistant)",
      "description": "Các kịch bản kiểm thử Chatbot tư vấn, Tool Calling thời gian thực và tra cứu chính sách",
      "item": [
        {
          "name": "1.1. Tool Calling - Tìm bãi xe ô tô con (SEDAN_SUV)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-User-Id",
                "value": "{{user_id}}"
              },
              {
                "key": "X-Correlation-Id",
                "value": "test-chat-tool-001"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"Tìm bãi xe ô tô gần Landmark 81 còn slot trống giúp tôi\",\n  \"userLat\": 10.795000,\n  \"userLon\": 106.721000\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/ai/chat",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "ai", "chat"]
            },
            "description": "Kiểm tra cơ chế Tool Calling tự động trích xuất loại xe SEDAN_SUV và tọa độ để gọi sang parking-lot-service"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response has success=true\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.success).to.be.true;",
                  "    pm.expect(json.data).to.have.property('reply');",
                  "    pm.expect(json.data.source).to.eql('REALTIME_SLOTS');",
                  "});",
                  "",
                  "pm.test(\"Suggested lots array is present\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.data.suggestedLots).to.be.an('array');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "1.2. Tool Calling - Tìm bãi xe cho xe tải (LIGHT_TRUCK)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-User-Id",
                "value": "{{user_id}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"Có bãi nào nhận xe tải nhỏ 2 tấn ở gần khu vực Thủ Đức không?\",\n  \"userLat\": 10.850000,\n  \"userLon\": 106.770000\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/ai/chat",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "ai", "chat"]
            },
            "description": "Nhận diện từ khóa 'xe tải nhỏ' -> ánh xạ thành VehicleTypeEnum.LIGHT_TRUCK"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Engine source is REALTIME_SLOTS\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.data.source).to.eql('REALTIME_SLOTS');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "1.3. In-Memory RAG - Quy định Giữ chỗ 10 phút & Hủy vé",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"Quy định giữ chỗ 10 phút và hủy vé trước giờ check in thế nào?\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/ai/chat",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "ai", "chat"]
            },
            "description": "Kiểm tra cơ chế tra cứu chính sách trong In-Memory Policy Knowledge Store"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Source is POLICY_FAQ\", function () {",
                  "    var json = pm.response.json();",
