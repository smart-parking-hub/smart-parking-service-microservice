    {
      "name": "2. AI Content Generator (Merchant Support)",
      "description": "Sinh mô tả bãi xe, nội quy an toàn PCCC và hướng dẫn đường đi cho chủ bãi",
      "item": [
        {
          "name": "2.1. Sinh mô tả bãi xe chuẩn SEO (Happy Path)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-User-Role",
                "value": "ROLE_MERCHANT"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"lotName\": \"Bãi Đỗ Xe An Khánh Thủ Đức\",\n  \"address\": \"120 Song Hành, P. An Phú, TP. Thủ Đức, TP.HCM\",\n  \"totalCapacity\": 75,\n  \"supportedVehicleTypes\": [\"SEDAN_SUV\", \"LIGHT_TRUCK\"],\n  \"amenities\": [\"Camera 24/7\", \"Có mái che\", \"Trạm sạc EV\"],\n  \"nearbyLandmarks\": \"Đối diện Mega Market An Phú, cách cầu Sài Gòn 1km\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/ai/generate-description",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "ai", "generate-description"]
            },
            "description": "Sinh đủ 3 phần: marketingDescription, operatingRegulations, wayfindingGuide"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"All 3 sections are generated\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.success).to.be.true;",
                  "    pm.expect(json.data.marketingDescription).to.be.a('string');",
                  "    pm.expect(json.data.operatingRegulations).to.be.a('string');",
                  "    pm.expect(json.data.wayfindingGuide).to.be.a('string');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
