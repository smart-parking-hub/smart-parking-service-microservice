    {
      "name": "3. AI Synthetic Mock Data (Admin & Tester)",
      "description": "Tự động sinh danh sách bãi xe có tọa độ GPS thật để test tải và demo",
      "item": [
        {
          "name": "3.1. Sinh Mock Data bãi xe theo khu vực (Count = 5)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-User-Role",
                "value": "ROLE_ADMIN"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"targetArea\": \"Quận 1, TP.HCM\",\n  \"count\": 5,\n  \"vehicleTypes\": [\"SEDAN_SUV\", \"LIGHT_TRUCK\"]\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/ai/generate-mock-data",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "ai", "generate-mock-data"]
            },
            "description": "Tạo ra 5 bãi xe với tọa độ GPS, phân bổ slot và mẫu review"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Array of 5 mock lots returned\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.success).to.be.true;",
                  "    pm.expect(json.data).to.be.an('array');",
                  "    pm.expect(json.data.length).to.eql(5);",
                  "    pm.expect(json.data[0]).to.have.property('latitude');",
                  "    pm.expect(json.data[0]).to.have.property('longitude');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
